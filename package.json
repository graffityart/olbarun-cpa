{
  "name": "olbarun-cpa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && npm run test:all && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:test-users": "node scripts/seed-test-users.mjs",
    "test:settlements": "node --test lib/settlement-list-filters.test.mjs lib/settlement-validation.test.mjs",
    "test:cpa": "node --test lib/cpa/*.test.mjs",
    "test:settlement-concurrency": "node --test lib/settlement-concurrency.test.mjs",
    "db:check-cpa-duplicates": "node scripts/check-cpa-accounting-duplicates.mjs",
    "test:posting-review": "node --test lib/posting-review-validation.test.mjs lib/posting-approval-validation.test.mjs",
    "test:all": "npm run test:cpa && npm run test:settlements && npm run test:settlement-concurrency && npm run test:posting-review && npm run test:payout-staging && npm run test:synthetic-seed && npm run test:origin && npm run test:auth-password && npm run test:payout-additive && npm run test:payout-route-contract && npm run test:payout-simulation && npm run test:payout-audit-matrix && npm run test:payout-local-preflight && npm run test:payout-auth-local-guards && npm run test:payout-auth-fixture-schema && npm run test:payout-release-preflight && npm run test:payout-preview-guards",
    "test:payout-staging": "node --test lib/payout-phase1-staging.test.mjs scripts/check-payout-phase1-staging.test.mjs",
    "db:check-payout-test": "node scripts/check-payout-test-db.mjs",
    "db:check-payout-schema": "node scripts/check-payout-test-schema.mjs",
    "db:audit-payout-migrations": "node scripts/audit-payout-migrations.mjs",
    "db:seed-payout-synthetic": "node scripts/seed-payout-synthetic-users.mjs",
    "db:check-payout-fixtures": "node scripts/check-payout-synthetic-fixtures.mjs",
    "test:synthetic-seed": "node --test scripts/seed-payout-synthetic-users.test.mjs",
    "test:payout-preview-http": "node scripts/check-payout-preview-http.mjs",
    "test:payout-preview-guards": "node --test scripts/check-payout-preview-http.test.mjs scripts/check-payout-test-db.test.mjs",
    "test:payout-local-http": "node scripts/check-payout-local-http.mjs",
    "test:payout-local-preflight": "node --test scripts/check-payout-local-http.test.mjs",
    "test:payout-auth-local-guards": "node --test scripts/payout-auth-http-local-guards.test.mjs",
    "test:payout-auth-fixture-schema": "node --test scripts/payout-auth-fixture-schema.test.mjs",
    "test:payout-release-preflight": "node --test scripts/check-payout-release-readiness.test.mjs",
    "test:origin": "node --test lib/security/origin.test.mjs",
    "test:auth-password": "node --test lib/auth/password.test.mjs",
    "test:payout-additive": "node --test scripts/seed-payout-isolated-additive.test.mjs",
    "test:payout-route-contract": "node --test lib/payout-route-contract.test.mjs",
    "test:payout-simulation": "node --test lib/payout-state-simulation.test.mjs",
    "test:payout-audit-matrix": "node --test lib/payout-audit-matrix.test.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "drizzle-orm": "latest",
    "next": "latest",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "latest",
    "typescript": "5.9.3"
  }
}
