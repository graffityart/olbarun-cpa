{
  "name": "olbarun-cpa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && npm run test:all && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:test-users": "node scripts/seed-test-users.mjs",
    "test:settlements": "node --test lib/settlement-list-filters.test.mjs lib/settlement-validation.test.mjs",
    "test:cpa": "node --test lib/cpa/*.test.mjs",
    "test:settlement-concurrency": "node --test lib/settlement-concurrency.test.mjs",
    "db:check-cpa-duplicates": "node scripts/check-cpa-accounting-duplicates.mjs",
    "test:posting-review": "node --test lib/posting-review-validation.test.mjs lib/posting-approval-validation.test.mjs",
    "test:all": "npm run test:cpa && npm run test:settlements && npm run test:settlement-concurrency && npm run test:posting-review && npm run test:payout-staging",
    "test:payout-staging": "node --test lib/payout-phase1-staging.test.mjs",
    "db:check-payout-test": "node scripts/check-payout-test-db.mjs",
    "db:check-payout-schema": "node scripts/check-payout-test-schema.mjs",
    "db:audit-payout-migrations": "node scripts/audit-payout-migrations.mjs",
    "db:seed-payout-synthetic": "node scripts/seed-payout-synthetic-users.mjs",
    "db:check-payout-fixtures": "node scripts/check-payout-synthetic-fixtures.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "drizzle-orm": "latest",
    "next": "latest",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "latest",
    "typescript": "5.9.3"
  }
}
